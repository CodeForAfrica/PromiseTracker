{
  "name": "promisetracker",
  "private": true,
  "description": "PromiseTracker v3: track what people in power promise and claim, and what happens next.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || echo 'Not a Git checkout, so no Git hooks to install'",
    "dev": "pnpm migrate && pnpm --filter @promisetracker/site dev",
    "build": "pnpm --filter @promisetracker/site build",
    "start": "pnpm --filter @promisetracker/site start",
    "payload": "pnpm --filter @promisetracker/cms payload",
    "migrate": "pnpm --filter @promisetracker/cms payload migrate",
    "migrate:check": "pnpm --filter @promisetracker/cms migrate:check",
    "generate": "pnpm --filter @promisetracker/cms generate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "test": "pnpm test:unit && pnpm test:int && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx seed/run.ts",
    "services": "node scripts/compose.mjs up -d",
    "stack": "node scripts/compose.mjs --profile app up -d --build",
    "services:down": "node scripts/compose.mjs down",
    "spec:pdf": "node scripts/spec-pdf.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@biomejs/js-api": "catalog:",
    "@biomejs/wasm-nodejs": "catalog:",
    "@next/env": "catalog:",
    "@playwright/test": "catalog:",
    "@promisetracker/cms": "workspace:*",
    "@promisetracker/contract": "workspace:*",
    "@promisetracker/kernel": "workspace:*",
    "@promisetracker/plugin-core": "workspace:*",
    "@promisetracker/plugin-site": "workspace:*",
    "@promisetracker/sdk": "workspace:*",
    "@promisetracker/ui": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "catalog:",
    "payload": "catalog:",
    "pg": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
