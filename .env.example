# Copy to .env.local (or .env) at the repository root: cp .env.example .env.local
# The site, the Payload CLI, the tests and Compose (through `pnpm services`) all read
# .env and then .env.local, and .env.local wins. Variables already set, as in CI, win over both.
# Every value except PAYLOAD_SECRET has a development default, so change only what you need.

# Required everywhere. Any long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Host ports for the Compose services. Move any that clash with something already
# running on your machine. The URLs below follow automatically.
PT_APP_PORT=3000
PT_POSTGRES_PORT=5432
PT_S3_PORT=9000
PT_S3_CONSOLE_PORT=9001
PT_TIKA_PORT=9998
PT_SMTP_PORT=1025
PT_MAIL_UI_PORT=8025

# The first super-admin, created at first start while no user exists. After that these are
# ignored and can be removed. Nobody can register through the admin. The password needs at least
# 12 characters.
PT_ADMIN_EMAIL=
PT_ADMIN_PASSWORD=

# Postgres
PT_POSTGRES_USER=promisetracker
PT_POSTGRES_PASSWORD=promisetracker
PT_POSTGRES_DB=promisetracker
# Required in production. In development it defaults to the URL built from the values above.
DATABASE_URL=postgres://${PT_POSTGRES_USER}:${PT_POSTGRES_PASSWORD}@localhost:${PT_POSTGRES_PORT}/${PT_POSTGRES_DB}

# File storage (RustFS in Compose). Leave S3_BUCKET empty to store files in ./media instead.
S3_BUCKET=promisetracker
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=promisetracker
S3_SECRET_ACCESS_KEY=promisetracker
S3_ENDPOINT=http://localhost:${PT_S3_PORT}
# Path-style addresses (endpoint/bucket) are used when S3_ENDPOINT is set. Set this to false for
# a custom endpoint that needs bucket.endpoint addresses, such as some AWS VPC endpoints.
# S3_FORCE_PATH_STYLE=true
# Leave both keys empty to use the AWS credential chain, such as an IAM role.
# The folder for files when S3_BUCKET is empty, relative to where the app starts.
# PT_MEDIA_DIR=media

# Email. No provider is chosen yet. Outside production, email goes to Mailpit from
# `pnpm services`, which keeps every message: read them at http://localhost:8025. In production
# nothing is sent until SMTP_HOST is set. The tests always send to Mailpit.
# A server not run with NODE_ENV=production, such as a staging one, sends to localhost unless
# SMTP_HOST is set, and fails only when it first sends. Set SMTP_HOST on every deployed server.
SMTP_HOST=localhost
SMTP_PORT=${PT_SMTP_PORT}
# SMTP_USER=
# SMTP_PASSWORD=
# PT_EMAIL_FROM=noreply@promisetracker.local
# PT_EMAIL_FROM_NAME=PromiseTracker

# Enabled plugins. Defaults to core,site, which are the only plugins that exist so far.
# core is always required.
PT_PLUGINS=core,site
# The languages in use, chosen from those registered in apps/cms/src/locales.ts: en, fr, pt, ar,
# sw. English is always on. Start-up stops on a code that is not registered. Defaults to en.
# PT_LOCALES=en,fr
# Chooses the verification adapter when more than one enabled plugin provides one. With only
# core enabled, the built-in `native` adapter is used and this can stay unset.
# PT_VERIFICATION=native
# The AI model, as provider:model. Needed only once an AI plugin is enabled. Ignored otherwise.
# PT_LLM_MODEL=google:gemini-2.5-pro

# The address people reach the site at, such as https://promisetracker.example.org. Links in
# emails, such as a failed document's or a password reset, use it. Unset, they are relative.
# PT_PUBLIC_URL=

# Where the web process listens. The worker calls it to refresh cached pages after a change.
# Defaults to http://127.0.0.1 on PORT, or 3000.
# PT_WEB_URL=http://127.0.0.1:3000

# Errors only a developer can fix go to Sentry when this is set. Leave it empty to run with no
# outside service. Logs and Sentry events never carry keys, tokens, passwords, email or network
# addresses.
# SENTRY_DSN=
# Defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=staging

# Set on staging and any other server search engines must not index. Every response then carries
# `X-Robots-Tag: noindex, nofollow`. Leave unset in production.
# PT_NOINDEX=true
# The lowest level logged: trace, debug, info, warn, error, fatal or silent. Defaults to info.
# PT_LOG_LEVEL=info

# Set by the Docker image, not by hand: `worker` also runs background jobs. Defaults to web.
# PT_ROLE=web
# In production, how long a starting process waits for another one to finish migrating.
# PT_STARTUP_LOCK_TIMEOUT_SECONDS=300
# The Compose project name. Change it to run two copies of the stack on one machine.
# PT_COMPOSE_PROJECT=promisetracker
# Tests never use the database above. Integration and browser tests each create their own
# beside it, named <database>_int_test and <database>_e2e_test, on the same local server, and
# refuse any other.
# Run the browser tests against a server that is already running, instead of starting one.
# That server's database is then up to you.
# PT_E2E_URL=http://localhost:3000
# The port of the server the browser tests start for themselves, beside `pnpm dev`.
# PT_E2E_PORT=3100
# Set by the browser tests, not by hand: the build folder of their own dev server.
# PT_NEXT_DIST_DIR=.next-e2e
